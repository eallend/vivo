# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Steps for the Firebase values are in docs/firebase-setup.md.

# Firebase web app settings (sent to the browser; copy from Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Same project id again; read only by the server to check sign-in tokens
FIREBASE_PROJECT_ID=

# Anthropic API key; read only by the server, never sent to the browser
ANTHROPIC_API_KEY=

# Optional (defaults shown)
# VIVA_TURN_MODEL=claude-haiku-5-5
# VIVA_REVISION_MODEL=claude-opus-5-5
# VIVA_CASE_PATH=docs/requirements/Eye Academy - Developer Take-Home (Case EA-VIVA-001).json
