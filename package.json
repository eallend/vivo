{
  "name": "vivo-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:note": "node scripts/prepare-note.ts",
    "check:privacy": "node --env-file=.env.local scripts/check-privacy.ts",
    "check:live": "node --env-file=.env.local scripts/check-live.ts",
    "start": "srvx serve --prod -s ../client --entry dist/server/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.4.0",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.1.1"
  }
}
